{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-destroy",
    "dialog:allow-open",
    "allow-read-file",
    "allow-save-file",
    "allow-terminal-start",
    "allow-terminal-write",
    "allow-terminal-resize",
    "allow-terminal-stop",
    "allow-list-directory"
  ]
}
