{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-destroy",
    "core:window:allow-close",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-is-maximized",
    "core:window:allow-start-dragging",
    "dialog:allow-open",
    "allow-create-file",
    "allow-create-folder",
    "allow-git-snapshot",
    "allow-git-action",
    "allow-git-status",
    "allow-read-file",
    "allow-save-file",
    "allow-terminal-start",
    "allow-terminal-write",
    "allow-terminal-resize",
    "allow-terminal-stop",
    "allow-terminal-popout",
    "allow-terminal-open-external",
    "allow-list-directory",
    "allow-restore-workspace",
    "allow-save-workspace",
    "allow-window-new"
  ]
}
